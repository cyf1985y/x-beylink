# 複製為 .env.local 並填入實際值（.env.local 已在 .gitignore，絕不 commit）

# LINE Login channel（developers.line.biz）
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# LINE Messaging API（官方帳號推播，M5 才會用到）
LINE_MESSAGING_ACCESS_TOKEN=

# Supabase（supabase.com → x-beylink 專案 → Settings → API）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session 簽章密鑰（隨機長字串，可用 `openssl rand -base64 32` 產生）
NEXTAUTH_SECRET=

# 網站根網址（本地 http://localhost:3000；正式 https://x-beylink.vercel.app）
NEXTAUTH_URL=http://localhost:3000
